    "\n",
    "# Tokens especiales\n",
    "PAD_TOKEN = '<pad>'\n",
    "UNK_TOKEN = '<unk>'\n",
    "SOS_TOKEN = '<sos>'\n",
    "EOS_TOKEN = '<eos>'\n",
    "\n",
    "print('⚙️  Parámetros configurados:')\n",
    "params = {\n",
