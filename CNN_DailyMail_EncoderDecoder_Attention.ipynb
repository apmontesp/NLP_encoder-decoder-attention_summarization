    "    'VOCAB_SIZE': VOCAB_SIZE, 'EMBED_DIM': EMBED_DIM, 'HIDDEN_DIM': HIDDEN_DIM,\n",
    "    'N_LAYERS': N_LAYERS, 'DROPOUT': DROPOUT, 'BATCH_SIZE': BATCH_SIZE,\n",
    "    'LEARNING_RATE': LEARNING_RATE, 'N_EPOCHS': N_EPOCHS\n",
    "}\n",
    "for k, v in params.items():\n",
    "    print(f'  {k:20s}: {v}')"
   ]
