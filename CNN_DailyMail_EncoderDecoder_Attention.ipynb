## 10.  Evaluación con Métricas ROUGE
from rouge_score import rouge_scorer as rs

def compute_rouge(dataset, n=200):
    scorer = rs.RougeScorer(['rouge1','rouge2','rougeL'], use_stemmer=True)
    scores = {'rouge1':[],'rouge2':[],'rougeL':[]}
    for i in range(min(n, len(dataset))):
        gen, _ = generate_summary(dataset[i]['article'], max_len=80)
        ref    = dataset[i]['highlights']
        result = scorer.score(ref, gen)
        for k in scores: scores[k].append(result[k].fmeasure)
        if (i+1)%50==0: print(f'  {i+1}/{n}...', end='\r')
    return {k: np.mean(v) for k,v in scores.items()}

print('⏳ Calculando ROUGE sobre 200 muestras del test set...')
rouge = compute_rouge(test_data, n=200)
print('\n RESULTADOS ROUGE:')
for k, v in rouge.items(): print(f'  {k.upper():8s}: {v:.4f} ({v*100:.2f}%)')

print('\n Contexto vs literatura:')
