  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "rouge-eval",
   "metadata": {},
   "outputs": [],
   "source": [
    "from rouge_score import rouge_scorer as rs\n",
    "\n",
    "def compute_rouge(model, dataset, vocab, n_samples=500):\n",
    "    \"\"\"Calcula ROUGE-1, ROUGE-2 y ROUGE-L sobre n_samples del dataset\"\"\"\n",
    "    scorer = rs.RougeScorer(['rouge1', 'rouge2', 'rougeL'], use_stemmer=True)\n",
    "    scores = {'rouge1': [], 'rouge2': [], 'rougeL': []}\n",
    "\n",
    "    model.eval()\n",
    "    for i in range(min(n_samples, len(dataset))):\n",
    "        sample = dataset[i]\n",
    "        generated, _, _ = generate_summary(model, sample['article'], vocab, max_len=80)\n",
    "        reference = sample['highlights']\n",
    "        result = scorer.score(reference, generated)\n",
    "        for k in scores:\n",
    "            scores[k].append(result[k].fmeasure)\n",
    "\n",
    "        if (i + 1) % 50 == 0:\n",
    "            print(f'  Procesado {i+1}/{n_samples}...', end='\\r')\n",
    "\n",
    "    return {k: np.mean(v) for k, v in scores.items()}\n",
    "\n",
    "\n",
    "print('⏳ Calculando ROUGE sobre 200 muestras del test set...')\n",
    "rouge_scores = compute_rouge(model, test_data, vocab, n_samples=200)\n",
    "\n",
    "print('\\n📊 RESULTADOS ROUGE:')\n",
    "print('='*40)\n",
    "for metric, score in rouge_scores.items():\n",
    "    print(f'  {metric.upper():8s}: {score:.4f} ({score*100:.2f}%)')\n",
    "\n",
    "# Comparación con baselines (valores típicos de literatura)\n",
    "print('\\n📚 Contexto (literatura):')\n",
    "baselines = [\n",
    "    ('Lead-3 (extractivo)',   0.401, 0.175, 0.365),\n",
    "    ('Seq2Seq básico',        0.358, 0.144, 0.330),\n",
    "    ('Seq2Seq+Atención',      0.374, 0.158, 0.346),\n",
    "    ('BART (SOTA)',           0.448, 0.214, 0.412),\n",
    "    ('Nuestro modelo',        rouge_scores['rouge1'], rouge_scores['rouge2'], rouge_scores['rougeL']),\n",
    "]\n",
    "print(f\"  {'Modelo':30s} {'R-1':>6} {'R-2':>6} {'R-L':>6}\")\n",
    "print('  ' + '-'*52)\n",
    "for name, r1, r2, rl in baselines:\n",
