def generate_summary(article, max_len=100, temperature=1.0):
    model.eval()
    with torch.no_grad():
        ids  = vocab.encode(article, max_len=MAX_ARTICLE_LEN)
        src  = torch.LongTensor(ids).unsqueeze(0).to(device)
        lens = torch.LongTensor([len(ids)])
        enc_out, hid, cell = model.encoder(src, lens)
        mask  = model.create_mask(src)
        toks  = [vocab.sos_idx]; attn_w = []
        token = torch.LongTensor([vocab.sos_idx]).to(device)
        for _ in range(max_len):
            pred, hid, cell, aw = model.decoder(token, hid, cell, enc_out, mask)
            if temperature != 1.0: pred = pred / temperature
            top1 = F.softmax(pred, dim=-1).argmax(1).item()
            toks.append(top1); attn_w.append(aw.squeeze(0).cpu().numpy())
            if top1 == vocab.eos_idx: break
            token = torch.LongTensor([top1]).to(device)
    return vocab.decode(toks), attn_w

