def load_glove(path, vocab, dim):
    glove = {}
    with open(path, encoding='utf-8') as f:
        for line in f:
            parts = line.split()
            if parts[0] in vocab.word2idx:
                glove[parts[0]] = np.array(parts[1:], dtype=np.float32)
    matrix = np.random.uniform(-0.1, 0.1, (len(vocab), dim)).astype(np.float32)
    matrix[vocab.pad_idx] = 0
    hits = sum(1 for w, idx in vocab.word2idx.items()
               if w in glove and not matrix.__setitem__(idx, glove[w]))  # trick
    # simpler loop
    hits = 0
    for word, idx in vocab.word2idx.items():
        if word in glove:
            matrix[idx] = glove[word]; hits += 1
    print(f'✅ Cobertura GloVe: {hits}/{len(vocab)} ({hits/len(vocab)*100:.1f}%)')
    return torch.FloatTensor(matrix)

embedding_matrix = load_glove(GLOVE_PATH, vocab, EMBED_DIM)

class SummarizationDataset(Dataset):
    def __init__(self, hf_data, vocab, max_art, max_sum, n=None):
        self.vocab=vocab; self.max_art=max_art; self.max_sum=max_sum
        self.data = [hf_data[i] for i in range(n or len(hf_data))]

    def __len__(self): return len(self.data)

    def __getitem__(self, idx):
        item = self.data[idx]
        src = self.vocab.encode(item['article'],    max_len=self.max_art)
        trg = self.vocab.encode(item['highlights'], max_len=self.max_sum-2, add_sos=True, add_eos=True)
        return torch.LongTensor(src), torch.LongTensor(trg)

def collate_fn(batch):
    srcs, trgs = zip(*batch)
    src_lens = [len(s) for s in srcs]
    src_pad = torch.zeros(len(srcs), max(src_lens), dtype=torch.long)
    trg_pad = torch.zeros(len(trgs), max(len(t) for t in trgs), dtype=torch.long)
    for i,(s,t) in enumerate(zip(srcs,trgs)):
        src_pad[i,:len(s)]=s; trg_pad[i,:len(t)]=t
    return src_pad, torch.LongTensor(src_lens), trg_pad

train_ds = SummarizationDataset(train_data, vocab, MAX_ARTICLE_LEN, MAX_SUMMARY_LEN, TRAIN_SAMPLES)
val_ds   = SummarizationDataset(val_data,   vocab, MAX_ARTICLE_LEN, MAX_SUMMARY_LEN, VAL_SAMPLES)
test_ds  = SummarizationDataset(test_data,  vocab, MAX_ARTICLE_LEN, MAX_SUMMARY_LEN, 1000)

train_loader = DataLoader(train_ds, BATCH_SIZE, shuffle=True,  collate_fn=collate_fn, num_workers=2)
val_loader   = DataLoader(val_ds,   BATCH_SIZE, shuffle=False, collate_fn=collate_fn, num_workers=2)
test_loader  = DataLoader(test_ds,  BATCH_SIZE, shuffle=False, collate_fn=collate_fn, num_workers=2)
print(f'✅ Train: {len(train_loader)} batches | Val: {len(val_loader)} | Test: {len(test_loader)}')

## 7.  Arquitectura: Encoder-Decoder con Atención de Bahdanau

```
Artículo → [Encoder BiLSTM + GloVe] → Estados ocultos h₁...hₙ
                                                ↓
                                [Atención Bahdanau] ← sₜ (decoder hidden)
                                        ↓
                                e(t,i) = v·tanh(W_enc·hᵢ + W_dec·sₜ)
                                α = softmax(e)
                                cₜ = Σ αᵢhᵢ  (context vector)
                                        ↓
                            [Decoder LSTM] → [Linear] → Token
```

**Referencias:**
- Bahdanau et al. (2015) — *Neural Machine Translation by Jointly Learning to Align and Translate*
- See et al. (2017) — *Get To The Point: Summarization with Pointer-Generator Networks*

class Encoder(nn.Module):
    """BiLSTM Encoder con embeddings GloVe preentrenados."""
    def __init__(self, vocab_size, embed_dim, hidden_dim, n_layers, dropout, emb_matrix):
        super().__init__()
        self.hidden_dim=hidden_dim; self.n_layers=n_layers
        self.embedding = nn.Embedding(vocab_size, embed_dim, padding_idx=0)
        self.embedding.weight = nn.Parameter(emb_matrix)
        self.rnn = nn.LSTM(embed_dim, hidden_dim, n_layers, batch_first=True,
                           bidirectional=True, dropout=dropout if n_layers>1 else 0)
        self.dropout = nn.Dropout(dropout)
        self.fc_h = nn.Linear(hidden_dim*2, hidden_dim)
        self.fc_c = nn.Linear(hidden_dim*2, hidden_dim)

    def forward(self, src, src_lens):
        emb = self.dropout(self.embedding(src))
        packed = pack_padded_sequence(emb, src_lens.cpu(), batch_first=True, enforce_sorted=False)
        outputs, (h, c) = self.rnn(packed)
        outputs, _ = pad_packed_sequence(outputs, batch_first=True)
        return outputs, self._proj(h, self.fc_h), self._proj(c, self.fc_c)

    def _proj(self, s, fc):
        s = s.view(self.n_layers, 2, s.shape[1], self.hidden_dim)
        return torch.stack([torch.tanh(fc(torch.cat([s[i,0],s[i,1]],dim=1)))
                            for i in range(self.n_layers)])

print('✅ Encoder definido')

class BahdanauAttention(nn.Module):
    """Atención Aditiva (Bahdanau et al., 2015)."""
    def __init__(self, enc_hid, dec_hid):
        super().__init__()
        self.W_enc = nn.Linear(enc_hid*2, dec_hid, bias=False)
        self.W_dec = nn.Linear(dec_hid,   dec_hid, bias=False)
        self.v     = nn.Linear(dec_hid,   1,        bias=False)

    def forward(self, enc_out, dec_hid, mask=None):
        # enc_out: (B, S, 2H) | dec_hid: (B, H)
        energy = torch.tanh(self.W_enc(enc_out) + self.W_dec(dec_hid).unsqueeze(1))
        scores = self.v(energy).squeeze(2)          # (B, S)
        if mask is not None:
            scores = scores.masked_fill(mask==0, float('-inf'))
        alpha   = F.softmax(scores, dim=1)          # (B, S)
        context = torch.bmm(alpha.unsqueeze(1), enc_out).squeeze(1)  # (B, 2H)
        return context, alpha

print('✅ Mecanismo de Atención de Bahdanau definido')

class Decoder(nn.Module):
    """LSTM Decoder con Atención de Bahdanau."""
    def __init__(self, vocab_size, embed_dim, enc_hid, dec_hid, n_layers, dropout, emb_matrix, attn):
        super().__init__()
        self.vocab_size=vocab_size; self.attention=attn
        self.embedding = nn.Embedding(vocab_size, embed_dim, padding_idx=0)
        self.embedding.weight = nn.Parameter(emb_matrix)
        self.rnn     = nn.LSTM(embed_dim+enc_hid*2, dec_hid, n_layers,
                               batch_first=True, dropout=dropout if n_layers>1 else 0)
        self.dropout = nn.Dropout(dropout)
        self.fc_out  = nn.Linear(dec_hid+enc_hid*2+embed_dim, vocab_size)

    def forward(self, token, hidden, cell, enc_out, mask=None):
        emb = self.dropout(self.embedding(token.unsqueeze(1)))   # (B,1,E)
        ctx, alpha = self.attention(enc_out, hidden[-1], mask)
        rnn_in = torch.cat([emb, ctx.unsqueeze(1)], dim=2)
        out, (hidden, cell) = self.rnn(rnn_in, (hidden, cell))
        pred = self.fc_out(torch.cat([out.squeeze(1), ctx, emb.squeeze(1)], dim=1))
        return pred, hidden, cell, alpha

print('✅ Decoder definido')

class Seq2Seq(nn.Module):
    def __init__(self, encoder, decoder, device, pad_idx=0):
        super().__init__()
        self.encoder=encoder; self.decoder=decoder
        self.device=device;   self.pad_idx=pad_idx

    def create_mask(self, src): return (src != self.pad_idx)

    def forward(self, src, src_lens, trg, tf_ratio=0.5):
        B, T = src.shape[0], trg.shape[1]
        enc_out, hid, cell = self.encoder(src, src_lens)
        mask    = self.create_mask(src)
        outputs = torch.zeros(B, T, self.decoder.vocab_size).to(self.device)
        token   = trg[:, 0]
        for t in range(1, T):
            pred, hid, cell, _ = self.decoder(token, hid, cell, enc_out, mask)
            outputs[:, t] = pred
            token = trg[:,t] if random.random() < tf_ratio else pred.argmax(1)
        return outputs

# Instanciar
attn    = BahdanauAttention(HIDDEN_DIM, HIDDEN_DIM)
encoder = Encoder(len(vocab), EMBED_DIM, HIDDEN_DIM, N_LAYERS, DROPOUT, embedding_matrix)
decoder = Decoder(len(vocab), EMBED_DIM, HIDDEN_DIM, HIDDEN_DIM, N_LAYERS, DROPOUT, embedding_matrix, attn)
model   = Seq2Seq(encoder, decoder, device).to(device)

total     = sum(p.numel() for p in model.parameters())
trainable = sum(p.numel() for p in model.parameters() if p.requires_grad)
print(f'✅ Modelo Seq2Seq instanciado')
print(f'   Total parámetros:      {total:,}')
print(f'   Parámetros entrenables:{trainable:,}')

## 8.  Entrenamiento
optimizer = torch.optim.Adam(model.parameters(), lr=LEARNING_RATE, weight_decay=1e-5)
scheduler = torch.optim.lr_scheduler.ReduceLROnPlateau(optimizer, patience=2, factor=0.5, verbose=True)
criterion = nn.CrossEntropyLoss(ignore_index=vocab.pad_idx)

def train_epoch(model, loader, opt, crit, clip, device, tf):
    model.train(); total_loss = 0
    for i, (src, src_lens, trg) in enumerate(loader):
        src, trg = src.to(device), trg.to(device)
        opt.zero_grad()
        out = model(src, src_lens, trg, tf)
        loss = crit(out[:,1:].reshape(-1, out.shape[-1]), trg[:,1:].reshape(-1))
        loss.backward()
        nn.utils.clip_grad_norm_(model.parameters(), clip)
        opt.step(); total_loss += loss.item()
        if (i+1) % 200 == 0: print(f'  batch {i+1}/{len(loader)} loss={total_loss/(i+1):.4f}', end='\r')
    return total_loss / len(loader)

def eval_epoch(model, loader, crit, device):
    model.eval(); total_loss = 0
    with torch.no_grad():
        for src, src_lens, trg in loader:
            src, trg = src.to(device), trg.to(device)
            out = model(src, src_lens, trg, tf_ratio=0.0)
            total_loss += crit(out[:,1:].reshape(-1,out.shape[-1]), trg[:,1:].reshape(-1)).item()
    return total_loss / len(loader)

print('✅ Optimizador, scheduler y criterio configurados')

history = {'train_loss':[], 'val_loss':[], 'train_ppl':[], 'val_ppl':[]}
best_val = float('inf')
MODEL_PATH = 'best_model.pt'

print(f' Entrenando {N_EPOCHS} épocas...'); print('='*60)
for epoch in range(N_EPOCHS):
    t0 = time.time()
    tf = max(0.3, 0.9 - epoch * 0.12)
    tr_loss = train_epoch(model, train_loader, optimizer, criterion, CLIP, device, tf)
    vl_loss = eval_epoch(model,  val_loader,   criterion, device)
    scheduler.step(vl_loss)
    tr_ppl, vl_ppl = math.exp(tr_loss), math.exp(vl_loss)
    history['train_loss'].append(tr_loss); history['val_loss'].append(vl_loss)
    history['train_ppl'].append(tr_ppl);  history['val_ppl'].append(vl_ppl)
    mark = '⭐ MEJOR' if vl_loss < best_val else ''
    if vl_loss < best_val:
        best_val = vl_loss
        torch.save({'epoch':epoch,'model_state':model.state_dict(),'val_loss':vl_loss}, MODEL_PATH)
    print(f'Época {epoch+1:2d}/{N_EPOCHS} [{time.time()-t0:.0f}s] '
          f'| Train: {tr_loss:.4f} (PPL {tr_ppl:.1f}) '
          f'| Val: {vl_loss:.4f} (PPL {vl_ppl:.1f}) | TF={tf:.2f} {mark}')
print('='*60); print(f'✅ Mejor Val Loss: {best_val:.4f}')

fig, (ax1, ax2) = plt.subplots(1, 2, figsize=(14, 5))
fig.suptitle(' Curvas de Entrenamiento', fontsize=14, fontweight='bold')
ep = range(1, len(history['train_loss'])+1)

ax1.plot(ep, history['train_loss'], 'b-o', label='Train', lw=2)
ax1.plot(ep, history['val_loss'],   'r-o', label='Val',   lw=2)
ax1.set_title('Cross-Entropy Loss'); ax1.set_xlabel('Época'); ax1.legend(); ax1.grid(alpha=0.3)

ax2.plot(ep, history['train_ppl'], 'b-o', label='Train', lw=2)
ax2.plot(ep, history['val_ppl'],   'r-o', label='Val',   lw=2)
ax2.set_title('Perplexity'); ax2.set_xlabel('Época'); ax2.legend(); ax2.grid(alpha=0.3)

