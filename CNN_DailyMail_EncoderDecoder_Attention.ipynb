   "source": [
    "# Cargar mejor modelo\n",
    "checkpoint = torch.load(MODEL_PATH, map_location=device)\n",
    "model.load_state_dict(checkpoint['model_state'])\n",
    "print(f'✅ Mejor modelo cargado (época {checkpoint[\"epoch\"]+1}, Val Loss: {checkpoint[\"val_loss\"]:.4f})')\n",
    "\n",
    "\n",
    "def generate_summary(model, article_text, vocab, max_len=100, beam_size=1, device=device):\n",
    "    \"\"\"\n",
    "    Genera un resumen para un artículo dado.\n",
    "    Soporta greedy search (beam_size=1) y beam search básico.\n",
    "    \"\"\"\n",
    "    model.eval()\n",
    "    with torch.no_grad():\n",
    "        # Tokenizar artículo\n",
    "        src_ids  = vocab.encode(article_text, max_len=MAX_ARTICLE_LEN)\n",
    "        src_len  = len(src_ids)\n",
    "        src      = torch.LongTensor(src_ids).unsqueeze(0).to(device)\n",
    "        src_lens = torch.LongTensor([src_len])\n",
    "\n",
    "        # Codificar\n",
    "        enc_out, hidden, cell = model.encoder(src, src_lens)\n",
    "        src_mask = model.create_mask(src)\n",
    "\n",
    "        # Decodificar greedy\n",
    "        tokens     = [vocab.sos_idx]\n",
    "        attn_store = []\n",
    "        input_tok  = torch.LongTensor([vocab.sos_idx]).to(device)\n",
    "\n",
    "        for _ in range(max_len):\n",
    "            pred, hidden, cell, attn_w = model.decoder(input_tok, hidden, cell, enc_out, src_mask)\n",
    "            top1 = pred.argmax(1).item()\n",
    "            tokens.append(top1)\n",
    "            attn_store.append(attn_w.squeeze(0).cpu().numpy())\n",
    "            if top1 == vocab.eos_idx:\n",
    "                break\n",
    "            input_tok = torch.LongTensor([top1]).to(device)\n",
    "\n",
    "        summary = vocab.decode(tokens)\n",
    "        return summary, attn_store, src_ids\n",
    "\n",
    "\n",
    "# Generar resúmenes de ejemplo\n",
    "print('\\n' + '='*60)\n",
    "print('📝 EJEMPLOS DE RESÚMENES GENERADOS')\n",
    "print('='*60)\n",
    "\n",
    "for i in range(3):\n",
    "    sample = test_data[i]\n",
    "    generated, attn_weights, src_ids = generate_summary(model, sample['article'], vocab)\n",
    "    print(f'\\n🔹 Ejemplo {i+1}:')\n",
    "    print(f'  📄 Artículo (primeros 200 chars): {sample[\"article\"][:200]}...')\n",
    "    print(f'  🎯 Referencia:  {sample[\"highlights\"][:200]}')\n",
    "    print(f'  🤖 Generado:    {generated}')"
