        ('BART (SOTA)',0.448,0.214,0.412),('⭐ Nuestro modelo',rouge['rouge1'],rouge['rouge2'],rouge['rougeL'])]
print(f"  {'Modelo':25s} {'R-1':>6} {'R-2':>6} {'R-L':>6}")
for n,r1,r2,rl in rows: print(f'  {n:25s} {r1:.3f}  {r2:.3f}  {rl:.3f}')

systems = ['Lead-3','Seq2Seq\nBásico','Seq2Seq\n+Atención','Pointer\nGen.','BART','Nuestro\nModelo']
