    "    val = file_uploader.value\n",
    "    if not val:\n",
    "        return None, None\n",
    "    if isinstance(val, dict):  # ipywidgets v7\n",
    "        for fname, info in val.items():\n",
    "            return fname, info['content']\n",
    "    if isinstance(val, (tuple, list)):  # ipywidgets v8\n",
