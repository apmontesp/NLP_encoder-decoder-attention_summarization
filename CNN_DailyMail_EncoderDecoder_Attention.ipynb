  {
   "cell_type": "code",
   "execution_count": null,
   "id": "vocabulary",
   "metadata": {},
   "outputs": [],
   "source": [
    "import re\n",
    "\n",
    "def simple_tokenize(text):\n",
    "    \"\"\"Tokenización simple: lowercase + split por palabras\"\"\"\n",
    "    text = text.lower()\n",
    "    text = re.sub(r\"[^a-z0-9\\s']\", ' ', text)\n",
    "    return text.split()\n",
    "\n",
    "class Vocabulary:\n",
    "    def __init__(self, max_size=None):\n",
    "        self.max_size = max_size\n",
    "        self.word2idx = {}\n",
    "        self.idx2word = {}\n",
    "        self.word_freq = Counter()\n",
    "        # Tokens especiales\n",
    "        for i, tok in enumerate([PAD_TOKEN, UNK_TOKEN, SOS_TOKEN, EOS_TOKEN]):\n",
    "            self.word2idx[tok] = i\n",
    "            self.idx2word[i] = tok\n",
    "        self.pad_idx = 0\n",
    "        self.unk_idx = 1\n",
    "        self.sos_idx = 2\n",
    "        self.eos_idx = 3\n",
    "\n",
    "    def build(self, texts):\n",
    "        for text in texts:\n",
    "            self.word_freq.update(simple_tokenize(text))\n",
    "        common = self.word_freq.most_common(self.max_size - 4 if self.max_size else None)\n",
    "        for word, _ in common:\n",
    "            idx = len(self.word2idx)\n",
    "            self.word2idx[word] = idx\n",
    "            self.idx2word[idx] = word\n",
    "\n",
    "    def encode(self, text, max_len=None, add_eos=False, add_sos=False):\n",
    "        tokens = simple_tokenize(text)\n",
    "        if max_len:\n",
    "            tokens = tokens[:max_len]\n",
    "        ids = [self.word2idx.get(t, self.unk_idx) for t in tokens]\n",
    "        if add_sos:\n",
    "            ids = [self.sos_idx] + ids\n",
    "        if add_eos:\n",
    "            ids = ids + [self.eos_idx]\n",
    "        return ids\n",
    "\n",
    "    def decode(self, ids, skip_special=True):\n",
    "        special = {self.pad_idx, self.sos_idx, self.eos_idx}\n",
    "        words = []\n",
    "        for i in ids:\n",
    "            if skip_special and i in special:\n",
    "                continue\n",
    "            if i == self.eos_idx:\n",
    "                break\n",
    "            words.append(self.idx2word.get(i, UNK_TOKEN))\n",
    "        return ' '.join(words)\n",
    "\n",
    "    def __len__(self):\n",
    "        return len(self.word2idx)\n",
    "\n",
    "\n",
    "# Construir vocabulario\n",
    "print('⏳ Construyendo vocabulario (puede tomar 1-2 min)...')\n",
    "build_samples = TRAIN_SAMPLES or len(train_data)\n",
    "all_texts = [train_data[i]['article'] for i in range(build_samples)] + \\\n",
    "            [train_data[i]['highlights'] for i in range(build_samples)]\n",
    "\n",
    "vocab = Vocabulary(max_size=VOCAB_SIZE)\n",
    "vocab.build(all_texts)\n",
    "print(f'✅ Vocabulario construido: {len(vocab):,} palabras')\n",
    "\n",
    "# Palabras más frecuentes\n",
    "print('\\n📋 Top 20 palabras más frecuentes:')\n",
    "print([w for w, _ in vocab.word_freq.most_common(20)])"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "glove-embeddings",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Descargar y cargar embeddings GloVe 6B 100d\n",
    "import urllib.request\n",
    "import zipfile\n",
    "\n",
    "GLOVE_PATH = 'glove.6B.100d.txt'\n",
    "\n",
    "if not os.path.exists(GLOVE_PATH):\n",
    "    print('⏳ Descargando GloVe embeddings (862 MB)...')\n",
    "    url = 'https://nlp.stanford.edu/data/glove.6B.zip'\n",
    "    urllib.request.urlretrieve(url, 'glove.6B.zip')\n",
    "    with zipfile.ZipFile('glove.6B.zip', 'r') as zf:\n",
    "        zf.extract('glove.6B.100d.txt')\n",
    "    print('✅ GloVe descargado')\n",
    "else:\n",
    "    print('✅ GloVe ya disponible')\n",
    "\n",
    "def load_glove_embeddings(path, vocab, embed_dim):\n",
    "    \"\"\"Carga embeddings GloVe y crea la matriz de embeddings\"\"\"\n",
    "    print(f'⏳ Cargando GloVe ({embed_dim}d)...')\n",
    "    glove = {}\n",
    "    with open(path, 'r', encoding='utf-8') as f:\n",
    "        for line in f:\n",
    "            parts = line.split()\n",
    "            word = parts[0]\n",
    "            if word in vocab.word2idx:\n",
    "                glove[word] = np.array(parts[1:], dtype=np.float32)\n",
    "\n",
    "    # Matriz de embeddings\n",
    "    emb_matrix = np.random.uniform(-0.1, 0.1, (len(vocab), embed_dim)).astype(np.float32)\n",
    "    emb_matrix[vocab.pad_idx] = np.zeros(embed_dim)\n",
    "    hits = 0\n",
    "    for word, idx in vocab.word2idx.items():\n",
    "        if word in glove:\n",
    "            emb_matrix[idx] = glove[word]\n",
    "            hits += 1\n",
    "\n",
    "    coverage = hits / len(vocab) * 100\n",
    "    print(f'✅ Embeddings cargados: {hits:,}/{len(vocab):,} palabras ({coverage:.1f}% cobertura)')\n",
    "    return torch.FloatTensor(emb_matrix)\n",
    "\n",
    "embedding_matrix = load_glove_embeddings(GLOVE_PATH, vocab, EMBED_DIM)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "dataset-class",
   "metadata": {},
   "outputs": [],
   "source": [
    "class SummarizationDataset(Dataset):\n",
    "    \"\"\"Dataset para la tarea de summarización\"\"\"\n",
    "    def __init__(self, hf_dataset, vocab, max_article_len, max_summary_len, n_samples=None):\n",
    "        self.vocab = vocab\n",
    "        self.max_article_len = max_article_len\n",
    "        self.max_summary_len = max_summary_len\n",
    "        n = n_samples or len(hf_dataset)\n",
    "        self.data = [hf_dataset[i] for i in range(n)]\n",
    "\n",
    "    def __len__(self):\n",
    "        return len(self.data)\n",
    "\n",
    "    def __getitem__(self, idx):\n",
    "        item = self.data[idx]\n",
    "        src = self.vocab.encode(item['article'], max_len=self.max_article_len)\n",
    "        trg = self.vocab.encode(item['highlights'], max_len=self.max_summary_len - 2,\n",
    "                                 add_sos=True, add_eos=True)\n",
    "        return torch.LongTensor(src), torch.LongTensor(trg)\n",
    "\n",
    "\n",
    "def collate_fn(batch):\n",
    "    \"\"\"Padding para batches de longitud variable\"\"\"\n",
    "    srcs, trgs = zip(*batch)\n",
    "    src_lens = [len(s) for s in srcs]\n",
    "    trg_lens = [len(t) for t in trgs]\n",
    "    src_padded = torch.zeros(len(srcs), max(src_lens), dtype=torch.long)\n",
    "    trg_padded = torch.zeros(len(trgs), max(trg_lens), dtype=torch.long)\n",
    "    for i, (s, t) in enumerate(zip(srcs, trgs)):\n",
    "        src_padded[i, :len(s)] = s\n",
    "        trg_padded[i, :len(t)] = t\n",
    "    return src_padded, torch.LongTensor(src_lens), trg_padded\n",
    "\n",
    "\n",
    "# Crear datasets y dataloaders\n",
    "print('⏳ Creando datasets...')\n",
    "train_dataset = SummarizationDataset(train_data, vocab, MAX_ARTICLE_LEN, MAX_SUMMARY_LEN, TRAIN_SAMPLES)\n",
    "val_dataset   = SummarizationDataset(val_data,   vocab, MAX_ARTICLE_LEN, MAX_SUMMARY_LEN, VAL_SAMPLES)\n",
    "test_dataset  = SummarizationDataset(test_data,  vocab, MAX_ARTICLE_LEN, MAX_SUMMARY_LEN, 1000)\n",
    "\n",
    "train_loader = DataLoader(train_dataset, batch_size=BATCH_SIZE, shuffle=True,\n",
    "                          collate_fn=collate_fn, num_workers=2, pin_memory=True)\n",
    "val_loader   = DataLoader(val_dataset,   batch_size=BATCH_SIZE, shuffle=False,\n",
    "                          collate_fn=collate_fn, num_workers=2, pin_memory=True)\n",
    "test_loader  = DataLoader(test_dataset,  batch_size=BATCH_SIZE, shuffle=False,\n",
    "                          collate_fn=collate_fn, num_workers=2, pin_memory=True)\n",
    "\n",
    "print(f'✅ DataLoaders creados:')\n",
    "print(f'  Train: {len(train_loader)} batches ({len(train_dataset):,} ejemplos)')\n",
    "print(f'  Val:   {len(val_loader)} batches ({len(val_dataset):,} ejemplos)')\n",
    "print(f'  Test:  {len(test_loader)} batches ({len(test_dataset):,} ejemplos)')"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "section-4",
   "metadata": {},
   "source": [
    "## 5. 🏗️ Arquitectura: Encoder-Decoder con Atención de Bahdanau\n",
    "\n",
    "Implementamos la arquitectura clásica de **Attention-based Seq2Seq** (Bahdanau et al., 2015):\n",
    "\n",
    "```\n",
    "Artículo → [Encoder LSTM] → Context Vectors\n",
    "                                 ↓\n",
    "              [Attention Mechanism] ← Decoder Hidden State\n",
    "                    ↓\n",
    "           Context Vector + Embedded Token\n",
    "                    ↓\n",
    "            [Decoder LSTM] → [Linear] → Token probabilities\n",
    "```\n",
    "\n",
    "**Componentes:**\n",
    "1. **Encoder**: LSTM bidireccional con embeddings GloVe congelados/ajustables\n",
    "2. **Atención de Bahdanau**: Alineación soft entre source y target\n",
    "3. **Decoder**: LSTM con context vector concatenado\n",
    "4. **Coverage mechanism**: Penaliza atender repetidamente las mismas posiciones"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "encoder",
   "metadata": {},
   "outputs": [],
   "source": [
    "class Encoder(nn.Module):\n",
    "    \"\"\"\n",
    "    Encoder LSTM Bidireccional con embeddings preentrenados GloVe.\n",
    "    Procesa la secuencia fuente y devuelve:\n",
    "      - outputs: todos los hidden states (batch, src_len, 2*hidden_dim)\n",
    "      - hidden/cell: estado final para inicializar el decoder\n",
    "    \"\"\"\n",
    "    def __init__(self, vocab_size, embed_dim, hidden_dim, n_layers, dropout, embedding_matrix):\n",
    "        super().__init__()\n",
    "        self.hidden_dim = hidden_dim\n",
    "        self.n_layers = n_layers\n",
    "\n",
    "        # Embeddings preentrenados GloVe\n",
    "        self.embedding = nn.Embedding(vocab_size, embed_dim, padding_idx=0)\n",
    "        self.embedding.weight = nn.Parameter(embedding_matrix)\n",
    "        self.embedding.weight.requires_grad = True  # fine-tune\n",
    "\n",
    "        # LSTM bidireccional\n",
    "        self.rnn = nn.LSTM(embed_dim, hidden_dim, n_layers,\n",
    "                           batch_first=True, bidirectional=True,\n",
    "                           dropout=dropout if n_layers > 1 else 0)\n",
    "        self.dropout = nn.Dropout(dropout)\n",
    "\n",
    "        # Proyección para combinar estados bidireccionales\n",
    "        self.fc_hidden = nn.Linear(hidden_dim * 2, hidden_dim)\n",
    "        self.fc_cell   = nn.Linear(hidden_dim * 2, hidden_dim)\n",
    "\n",
    "    def forward(self, src, src_lens):\n",
    "        # src: (batch, src_len)\n",
    "        embedded = self.dropout(self.embedding(src))\n",
    "\n",
    "        # Packed sequence para eficiencia con padding\n",
    "        packed = pack_padded_sequence(embedded, src_lens.cpu(), batch_first=True, enforce_sorted=False)\n",
    "        outputs, (hidden, cell) = self.rnn(packed)\n",
    "        outputs, _ = pad_packed_sequence(outputs, batch_first=True)\n",
    "        # outputs: (batch, src_len, 2*hidden_dim)\n",
    "        # hidden/cell: (2*n_layers, batch, hidden_dim)\n",
    "\n",
    "        # Combinar estados forward/backward para decoder\n",
    "        hidden = self._combine_bidir(hidden)\n",
    "        cell   = self._combine_bidir(cell)\n",
    "        return outputs, hidden, cell\n",
    "\n",
    "    def _combine_bidir(self, state):\n",
    "        \"\"\"Combina estados forward y backward: (2*layers, batch, H) → (layers, batch, H)\"\"\"\n",
    "        batch_size = state.shape[1]\n",
    "        state = state.view(self.n_layers, 2, batch_size, self.hidden_dim)\n",
    "        # Concatenar forward + backward y proyectar\n",
    "        combined = torch.cat([state[:, 0], state[:, 1]], dim=2)  # (layers, batch, 2H)\n",
    "        # Aplicar proyección por capa\n",
    "        projected = []\n",
    "        for i in range(self.n_layers):\n",
    "            proj = torch.tanh(self.fc_hidden(combined[i]))\n",
    "            projected.append(proj)\n",
    "        return torch.stack(projected)  # (layers, batch, H)\n",
    "\n",
    "\n",
    "print('✅ Encoder definido')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "attention",
   "metadata": {},
   "outputs": [],
   "source": [
    "class BahdanauAttention(nn.Module):\n",
    "    \"\"\"\n",
    "    Mecanismo de Atención de Bahdanau (Additive Attention).\n",
    "\n",
    "    Calcula scores de alineación entre:\n",
    "      - encoder_outputs: (batch, src_len, 2*hidden_dim)\n",
    "      - decoder_hidden:  (batch, hidden_dim)\n",
    "\n",
    "    Retorna:\n",
    "      - context_vector:  (batch, 2*hidden_dim)\n",
    "      - attention_weights: (batch, src_len)\n",
    "    \"\"\"\n",
    "    def __init__(self, enc_hidden_dim, dec_hidden_dim, attn_dim=None):\n",
    "        super().__init__()\n",
    "        attn_dim = attn_dim or dec_hidden_dim\n",
    "\n",
    "        # Proyecciones para encoder y decoder\n",
    "        self.attn_enc = nn.Linear(enc_hidden_dim * 2, attn_dim, bias=False)\n",
    "        self.attn_dec = nn.Linear(dec_hidden_dim, attn_dim, bias=False)\n",
    "        self.v = nn.Linear(attn_dim, 1, bias=False)  # vector energía\n",
    "\n",
    "    def forward(self, encoder_outputs, decoder_hidden, src_mask=None):\n",
    "        # encoder_outputs: (batch, src_len, 2H_enc)\n",
    "        # decoder_hidden:  (batch, H_dec)\n",
    "        batch_size = encoder_outputs.shape[0]\n",
    "        src_len    = encoder_outputs.shape[1]\n",
    "\n",
    "        # Proyectar y expandir para broadcasting\n",
    "        enc_proj = self.attn_enc(encoder_outputs)          # (batch, src_len, attn_dim)\n",
    "        dec_proj = self.attn_dec(decoder_hidden).unsqueeze(1)  # (batch, 1, attn_dim)\n",
    "\n",
    "        # Score de energía\n",
    "        energy = torch.tanh(enc_proj + dec_proj)           # (batch, src_len, attn_dim)\n",
    "        scores = self.v(energy).squeeze(2)                 # (batch, src_len)\n",
    "\n",
    "        # Máscara de padding\n",
    "        if src_mask is not None:\n",
    "            scores = scores.masked_fill(src_mask == 0, float('-inf'))\n",
    "\n",
    "        # Softmax → pesos de atención\n",
    "        attn_weights = F.softmax(scores, dim=1)            # (batch, src_len)\n",
    "\n",
    "        # Vector de contexto\n",
    "        context = torch.bmm(attn_weights.unsqueeze(1), encoder_outputs)  # (batch, 1, 2H_enc)\n",
    "        context = context.squeeze(1)                       # (batch, 2H_enc)\n",
    "\n",
    "        return context, attn_weights\n",
    "\n",
    "\n",
    "print('✅ Mecanismo de Atención de Bahdanau definido')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "decoder",
   "metadata": {},
   "outputs": [],
   "source": [
    "class Decoder(nn.Module):\n",
    "    \"\"\"\n",
    "    Decoder LSTM con Atención de Bahdanau.\n",
    "    En cada paso:\n",
    "      1. Embed el token anterior\n",
    "      2. Calcular atención sobre encoder_outputs\n",
    "      3. Concatenar embed + context → LSTM\n",
    "      4. Proyectar a vocabulario\n",
    "    \"\"\"\n",
    "    def __init__(self, vocab_size, embed_dim, enc_hidden_dim, dec_hidden_dim,\n",
    "                 n_layers, dropout, embedding_matrix, attention):\n",
    "        super().__init__()\n",
    "        self.vocab_size = vocab_size\n",
    "        self.attention  = attention\n",
    "\n",
    "        # Embeddings compartidos con encoder\n",
    "        self.embedding = nn.Embedding(vocab_size, embed_dim, padding_idx=0)\n",
    "        self.embedding.weight = nn.Parameter(embedding_matrix)\n",
    "        self.embedding.weight.requires_grad = True\n",
    "\n",
    "        # LSTM unidireccional\n",
    "        self.rnn = nn.LSTM(embed_dim + enc_hidden_dim * 2,  # embed + context\n",
    "                           dec_hidden_dim, n_layers,\n",
    "                           batch_first=True,\n",
    "                           dropout=dropout if n_layers > 1 else 0)\n",
    "        self.dropout = nn.Dropout(dropout)\n",
    "\n",
    "        # Capa de salida\n",
    "        self.fc_out = nn.Linear(dec_hidden_dim + enc_hidden_dim * 2 + embed_dim, vocab_size)\n",
    "\n",
    "    def forward(self, trg_token, hidden, cell, encoder_outputs, src_mask=None):\n",
    "        # trg_token: (batch,)\n",
    "        trg_token = trg_token.unsqueeze(1)  # (batch, 1)\n",
    "        embedded  = self.dropout(self.embedding(trg_token))  # (batch, 1, embed_dim)\n",
    "\n",
    "        # Atención usando el último hidden state de la capa superior\n",
    "        context, attn_weights = self.attention(encoder_outputs, hidden[-1], src_mask)\n",
    "        context = context.unsqueeze(1)  # (batch, 1, 2H_enc)\n",
    "\n",
    "        # Entrada al LSTM: [embedded || context]\n",
    "        rnn_input = torch.cat([embedded, context], dim=2)  # (batch, 1, embed+2H_enc)\n",
    "        output, (hidden, cell) = self.rnn(rnn_input, (hidden, cell))\n",
    "        # output: (batch, 1, H_dec)\n",
    "\n",
    "        # Predicción final: concatenar output, context, embedded (pointer-style)\n",
    "        output  = output.squeeze(1)   # (batch, H_dec)\n",
    "        context = context.squeeze(1)  # (batch, 2H_enc)\n",
    "        embedded = embedded.squeeze(1)  # (batch, embed)\n",
    "\n",
    "        prediction = self.fc_out(torch.cat([output, context, embedded], dim=1))  # (batch, vocab)\n",
    "        return prediction, hidden, cell, attn_weights\n",
    "\n",
    "\n",
    "print('✅ Decoder definido')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "seq2seq",
   "metadata": {},
   "outputs": [],
   "source": [
    "class Seq2Seq(nn.Module):\n",
    "    \"\"\"\n",
    "    Modelo Encoder-Decoder completo con Atención de Bahdanau.\n",
    "    Soporta teacher forcing durante el entrenamiento.\n",
    "    \"\"\"\n",
    "    def __init__(self, encoder, decoder, device, pad_idx=0):\n",
    "        super().__init__()\n",
    "        self.encoder = encoder\n",
    "        self.decoder = decoder\n",
    "        self.device  = device\n",
    "        self.pad_idx = pad_idx\n",
    "\n",
    "    def create_mask(self, src):\n",
    "        return (src != self.pad_idx)  # (batch, src_len)\n",
    "\n",
    "    def forward(self, src, src_lens, trg, teacher_forcing_ratio=0.5):\n",
    "        # src: (batch, src_len)\n",
    "        # trg: (batch, trg_len) — incluye <sos> y <eos>\n",
    "        batch_size = src.shape[0]\n",
    "        trg_len    = trg.shape[1]\n",
    "\n",
    "        # Codificar\n",
    "        encoder_outputs, hidden, cell = self.encoder(src, src_lens)\n",
    "        src_mask = self.create_mask(src)\n",
    "\n",
    "        # Tensor de salida\n",
    "        outputs   = torch.zeros(batch_size, trg_len, self.decoder.vocab_size).to(self.device)\n",
    "        all_attn  = torch.zeros(batch_size, trg_len, src.shape[1]).to(self.device)\n",
    "\n",
    "        # Primer token del decoder: <sos>\n",
    "        input_token = trg[:, 0]\n",
    "\n",
    "        for t in range(1, trg_len):\n",
    "            output, hidden, cell, attn_w = self.decoder(\n",
    "                input_token, hidden, cell, encoder_outputs, src_mask)\n",
    "            outputs[:, t]  = output\n",
    "            all_attn[:, t] = attn_w\n",
    "\n",
    "            # Teacher forcing\n",
    "            use_teacher = random.random() < teacher_forcing_ratio\n",
    "            top1 = output.argmax(1)\n",
    "            input_token = trg[:, t] if use_teacher else top1\n",
    "\n",
    "        return outputs, all_attn\n",
    "\n",
    "\n",
    "# Instanciar el modelo\n",
    "attn    = BahdanauAttention(HIDDEN_DIM, HIDDEN_DIM)\n",
    "encoder = Encoder(len(vocab), EMBED_DIM, HIDDEN_DIM, N_LAYERS, DROPOUT, embedding_matrix)\n",
    "decoder = Decoder(len(vocab), EMBED_DIM, HIDDEN_DIM, HIDDEN_DIM, N_LAYERS, DROPOUT, embedding_matrix, attn)\n",
    "model   = Seq2Seq(encoder, decoder, device).to(device)\n",
    "\n",
    "# Contar parámetros\n",
    "total_params     = sum(p.numel() for p in model.parameters())\n",
    "trainable_params = sum(p.numel() for p in model.parameters() if p.requires_grad)\n",
    "print(f'\\n🧮 Parámetros del modelo:')\n",
    "print(f'  Total:      {total_params:,}')\n",
    "print(f'  Entrenables:{trainable_params:,}')\n",
    "\n",
    "# Arquitectura\n",
    "print(f'\\n📐 Arquitectura:')\n",
    "print(model)"
   ]
  },
