    "# Visualizar mapa de atención\n",
    "def plot_attention(article_text, summary_text, attn_weights, vocab, max_src=40, max_trg=20):\n",
    "    src_tokens = simple_tokenize(article_text)[:max_src]\n",
    "    trg_tokens = simple_tokenize(summary_text)[:max_trg]\n",
