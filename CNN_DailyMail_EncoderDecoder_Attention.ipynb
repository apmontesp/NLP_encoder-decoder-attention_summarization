    print(f'   Referencia:  {s["highlights"][:150]}')
    print(f'   Generado:    {gen}')

def plot_attention(article, summary, attn_weights, max_src=40, max_trg=20):
    src_tok = simple_tokenize(article)[:max_src]
    trg_tok = simple_tokenize(summary)[:max_trg]
    n_t = min(len(attn_weights), len(trg_tok))
    n_s = min(len(src_tok), attn_weights[0].shape[0])
    mat = np.array([attn_weights[t][:n_s] for t in range(n_t)])

    fig, ax = plt.subplots(figsize=(n_s//2+2, n_t//2+2))
    im = ax.imshow(mat, cmap='viridis', aspect='auto')
    ax.set_xticks(range(n_s)); ax.set_xticklabels(src_tok[:n_s], rotation=90, fontsize=8)
    ax.set_yticks(range(n_t)); ax.set_yticklabels(trg_tok[:n_t], fontsize=9)
    ax.set_xlabel('Artículo (fuente)'); ax.set_ylabel('Resumen (objetivo)')
    ax.set_title(' Mapa de Atención — Bahdanau', fontweight='bold')
    plt.colorbar(im); plt.tight_layout()
    plt.savefig('attention_map.png', dpi=150); plt.show()

s = test_data[0]
